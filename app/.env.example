# Mẫu biến môi trường frontend Flutter MindClock (`--dart-define-from-file=.env`).
# KHÔNG điền khóa thật hoặc token vào tệp mẫu này; sao chép thành `app/.env` (đã bị .gitignore bỏ qua).

# URL gốc backend FastAPI (/v1 sẽ được PersonalApiClient tự nối)
# Ví dụ Android Emulator nối máy host: http://10.0.2.2:8000
# Ví dụ thiết bị thật qua adb reverse tcp:8000 tcp:8000: http://127.0.0.1:8000
MINDCLOCK_API_BASE_URL=http://10.0.2.2:8000

# Firebase Web API Key dùng cho Firebase Identity Toolkit (FirebaseAuthGateway)
# Không đặt Gemini API Key ở client; Gemini Key chỉ nằm trên backend.
MINDCLOCK_FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY

# Chỉ bật fixture mẫu ở build debug khi chưa có backend (`false` cho tích hợp thật/release)
MINDCLOCK_DEBUG_FIXTURE=false
