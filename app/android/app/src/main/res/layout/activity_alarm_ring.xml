<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mindclock_night_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/txtModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/mindclock_night_surface"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/mindclock_night_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAlarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="06:00"
            android:textColor="@color/mindclock_night_text_primary"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAlarmLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/mindclock_night_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAlarmHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/alarm_challenge_note"
            android:textColor="@color/mindclock_night_text_secondary"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="36dp" />

        <Button
            android:id="@+id/btnOpenQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:backgroundTint="@color/mindclock_night_accent"
            android:text="@string/alarm_open_question"
            android:textAllCaps="false"
            android:textColor="@color/mindclock_night_accent_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSnooze5Min"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="52dp"
            android:backgroundTint="@color/mindclock_night_surface"
            android:text="@string/alarm_snooze_5m"
            android:textAllCaps="false"
            android:textColor="@color/mindclock_night_text_primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEmergencyStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:backgroundTint="@color/mindclock_night_danger_bg"
            android:text="@string/alarm_emergency_stop"
            android:textAllCaps="false"
            android:textColor="@color/mindclock_night_danger"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
